# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# รหัสผ่าน Postgres (docker-compose ใช้ตอนสร้าง DB ครั้งแรก)
POSTGRES_PASSWORD=

# หน้า Buckets ช่อง Endpoint แล้วเติม https:// ข้างหน้า
B2_ENDPOINT=
# ส่วนกลางของ endpoint เช่น us-west-004
B2_REGION=
# keyID (ไม่ใช่ keyName)
B2_KEY_ID=
# applicationKey แสดงให้ดูครั้งเดียว ถ้าหายต้องสร้าง key ใหม่
B2_APP_KEY=
# ชื่อ bucket (ไม่ใช่ Bucket ID)
B2_BUCKET=